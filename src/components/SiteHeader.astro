---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
---
<header class="site-header">
  <a class="studio-mark" href="/" aria-label={`${site.name} home`}>
    <img class="studio-mark__glyph" src={site.logo.mark} alt="" width="32" height="32" />
    <span class="studio-mark__text">
      <b>{site.mark}</b>{site.markSuffix && <i>{site.markSuffix}</i>}
    </span>
  </a>
  <nav>
    <a href="/">Apps</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
  </nav>
  <ThemeToggle />
</header>
