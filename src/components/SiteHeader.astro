---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
---
<header class="site-header">
  <a class="studio-mark" href="/" aria-label={`${site.name} home`}>
    <span class="studio-mark__glyph" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round">
        <path d="M7 4c0 7 18 5 18 12S7 21 7 28" />
        <path d="M25 4c0 7-18 5-18 12s18 5 18 12" />
      </svg>
    </span>
    <span class="studio-mark__text">
      <b>{site.mark}</b>{site.markSuffix && <i>{site.markSuffix}</i>}
    </span>
  </a>
  <nav>
    <a href="/">Apps</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
  </nav>
  <ThemeToggle />
</header>
