---
import SimplePage from '../layouts/SimplePage.astro';
import { site } from '../data/site';
import { products } from '../data/products';
---
<SimplePage heading="Privacy" description={`How ${site.name} websites and apps handle your data.`}>
  <p>
    This page describes the {site.name} website. Each application has its own privacy
    policy covering the data and services relevant to that product.
  </p>
  <p>
    This site itself sets no tracking cookies. Your day/night theme choice is stored
    locally in your browser and never leaves your device.
  </p>
  <p>
    If you use the contact form, the name, email address, subject and message you provide
    are processed through Cloudflare to deliver your request. The site does not keep a
    separate contact-message database. Cloudflare Turnstile also processes technical
    signals to help prevent automated abuse.
  </p>
  <p>
    Questions about a specific app? Use our <a href="/contact">contact form</a>.
  </p>

  <h2>Application privacy policies</h2>
  <div class="legal-directory">
    {products.map((product) => (
      <a href={product.legal.privacyPath}>
        <span>{product.name}</span>
        <small>Read Privacy Policy →</small>
      </a>
    ))}
  </div>
</SimplePage>
